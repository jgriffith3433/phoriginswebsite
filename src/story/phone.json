  },
  "calls": {
    "voss-late": {
      "contact": "voss",
      "lines": [
        {
          "speaker": "voss",
          "text": "Pierce. You're late to the board meeting.",
          "audio": "/assets/audio/phone/voss-late.wav",
          "duration": 2.37
        },
        {
          "speaker": "pierce",
          "text": "I know. I'm down the hallway as we speak.",
          "audio": "/assets/audio/phone/pierce-hallway.wav",
          "duration": 2.65
        },
        {
          "speaker": "pierce",
          "text": "We need to be prepared for what's coming.",
          "audio": "/assets/audio/phone/pierce-prepared.wav",
          "duration": 2.32
        },
        {
          "speaker": "voss",
          "text": "Just... hurry up.",
          "audio": "/assets/audio/phone/voss-hurry.wav",
          "duration": 1.63
        }
      ]
    },
    "voss-meeting": {
      "contact": "voss",
      "lines": [
        {
          "speaker": "voss",
          "text": "Hale is still in that room. She is furious.",
          "audio": "/assets/audio/phone/voss-furious.wav",
          "duration": 3.3
        },
        {
          "speaker": "pierce",
          "text": "The meeting's over.",
          "audio": "/assets/audio/phone/pierce-over.wav",
          "duration": 1.3
        },
        {
          "speaker": "voss",
          "text": "Not to her. You don't walk out on a board.",
          "audio": "/assets/audio/phone/voss-board.wav",
          "duration": 2.8
        },
        {
          "speaker": "pierce",
          "text": "I did.",
          "audio": "/assets/audio/phone/pierce-did.wav",
          "duration": 0.9
        }
      ]
    },
    "hale-walkout": {
      "contact": "hale",
      "lines": [
        {
          "speaker": "hale",
          "text": "Pierce. You walked out of my board meeting.",
          "audio": "/assets/audio/phone/hale-walked-out.wav",
          "duration": 2.6
        },
        {
          "speaker": "hale",
          "text": "You will reschedule. Today.",
          "audio": "/assets/audio/phone/hale-reschedule.wav",
          "duration": 2.14
        },
        {
          "speaker": "pierce",
          "text": "I can't right now.",
          "audio": "/assets/audio/phone/pierce-cant.wav",
          "duration": 1.16
        },
        {
          "speaker": "hale",
          "text": "Then I have no choice. I will speak with the other investors.",
          "audio": "/assets/audio/phone/hale-investors.wav",
          "duration": 3.95
        },
        {
          "speaker": "hale",
          "text": "They will hear that you walked out.",
          "audio": "/assets/audio/phone/hale-hear.wav",
          "duration": 2.09
        }
      ]
    }
  },
