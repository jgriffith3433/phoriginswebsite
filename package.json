{
  "name": "ph-origins-3d-game",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --outDir play && node tools/postbuild.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "npm run build",
    "convert:fbx": "node tools/convert-fbx-to-glb.mjs",
    "bake:anims": "node tools/bake-player-anims.mjs",
    "textures": "node tools/process-textures.mjs",
    "check:leaks": "node tools/levelLeakCheck.mjs",
    "models:compress": "node tools/compress-models.mjs",
    "check:scene": "node tools/sceneAudit.mjs && node tools/clean-models.mjs --check && node tools/clipStride.mjs --check",
    "models:clean": "node tools/clean-models.mjs",
    "models:stride": "node tools/clipStride.mjs",
    "check:anim": "node tools/animCheck.mjs",
    "test": "npm run check:scene && npm run check:anim && npm run check:leaks"
  },
  "dependencies": {
    "@babylonjs/core": "^7.0.0",
    "@babylonjs/loaders": "^7.0.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "meshoptimizer": "^0.21.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
